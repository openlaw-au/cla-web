{
  "name": "cla-web-editor",
  "version": "0.1.0",
  "private": true,
  "description": "CLQ Proofing Editor — Next.js 16 + React 19 + TypeScript App Router rewrite of the ProseMirror-based CLQ proofing tool.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "next": "16.4.0",
    "orderedmap": "2.1.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-markdown": "1.13.8",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-basic": "1.2.5",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "w3c-keyname": "2.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1",
    "@playwright/test": "^1",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/markdown-it": "^14",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30",
    "prettier": "^3",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
